# ---------------------------------------------------------------------------
# OLCC Books v2 — environment variables
# Copy this file to `.env.local` (which is .gitignored) and fill in real values.
# In Vercel production these go under Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# ---- Supabase (Project Settings → API) ----
# The "Project URL" of your Supabase project, e.g. https://abcd.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Newer Supabase projects call this "publishable key" (older ones called it "anon key").
# Either way, it's the PUBLIC key safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — server-only, NEVER expose to the client. Used by
# cron routes that need to write on behalf of the system.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini OCR (https://aistudio.google.com) ----
# Reuse the key from v1 — same key works for both projects.
GEMINI_API_KEY=

# ---- Resend (https://resend.com) ----
# Used for invoice/receipt customer emails + Cron-based recurring reminders.
RESEND_API_KEY=

# From-address Resend should send as. Until you verify a custom domain,
# use "OLCC Books <onboarding@resend.dev>" — Resend's default sender.
RESEND_FROM="OLCC Books <onboarding@resend.dev>"

# ---- Vercel Cron secret (optional; set in Vercel + add to vercel.json) ----
# A random string that Vercel Cron sends in the Authorization header so
# the cron routes can reject unauthorized hits.
CRON_SECRET=
