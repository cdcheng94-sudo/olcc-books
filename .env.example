# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (receipt OCR)
GEMINI_API_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM=OLCC Books <onboarding@resend.dev>

# Vercel Cron auth
CRON_SECRET=

# ---- Google Drive integration (receipt storage) ----
# See GOOGLE_DRIVE_SETUP.md for how to obtain these.
# Uses drive.file scope; the app self-creates the "OLCC Books" root folder.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_OWNER_EMAIL=
DRIVE_SETUP_SECRET=
